---
interface Props {
	name: 'github' | 'linkedin' | 'mail';
	title?: string;
}

const { name, title } = Astro.props;
---

<svg
	class="platform-icon"
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="1.8"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden={title ? undefined : 'true'}
	role={title ? 'img' : undefined}
>
	{title && <title>{title}</title>}
	{
		name === 'github' && (
			<>
				<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.2c3.2-.35 6.5-1.55 6.5-7.05A5.55 5.55 0 0 0 19 3.85 5.1 5.1 0 0 0 18.9 1S17.7.65 15 2.45a13.2 13.2 0 0 0-6 0C6.3.65 5.1 1 5.1 1A5.1 5.1 0 0 0 5 3.85 5.55 5.55 0 0 0 3.5 7.7c0 5.5 3.3 6.7 6.5 7.05a4.8 4.8 0 0 0-1 3.2v4" />
				<path d="M9 18c-4.45 2-5-2-7-2" />
			</>
		)
	}
	{
		name === 'linkedin' && (
			<>
				<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-4 0v7h-4v-7a6 6 0 0 1 6-6z" />
				<rect x="2" y="9" width="4" height="12" />
				<circle cx="4" cy="4" r="2" fill="currentColor" stroke="none" />
			</>
		)
	}
	{
		name === 'mail' && (
			<>
				<rect x="2" y="4" width="20" height="16" rx="2" />
				<path d="m22 7-8.97 5.7a2 2 0 0 1-2.06 0L2 7" />
			</>
		)
	}
</svg>